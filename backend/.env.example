# ===== Backend - Mais Horas (FastAPI) =====

# Porta do servidor
PORT=3000

# development | production
ENVIRONMENT=development

# String de conexão PostgreSQL
# Local (Docker compose deste repo): porta 5433 no host
# Aceita tanto postgresql:// quanto postgresql+asyncpg:// — a app normaliza
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mais_horas

# Em produção (Render) defina PGSSL=true (ou ENVIRONMENT=production)
PGSSL=false

# Secret usada para assinar o JWT (obrigatória — a app não sobe sem ela)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-isto-por-uma-string-aleatoria-longa

# Tempo de vida dos tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# URL pública da API
APP_URL=http://localhost:3000

# URL pública do frontend (usada no QR Code de verificação dos certificados)
WEB_URL=http://localhost:5173

# Origens permitidas no CORS (separadas por vírgula).
# Vazio libera todas — só funciona em dev; em produção a app exige valor.
# CORS_ORIGIN=https://mais-horas-web.onrender.com
