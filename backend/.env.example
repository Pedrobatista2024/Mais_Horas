# ===== Mais Horas — Backend (FastAPI) =====

PORT=3000
# desenvolvimento | producao
AMBIENTE=desenvolvimento

# ===== Banco =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mais_horas
DATABASE_URL_TESTE=postgresql://postgres:postgres@localhost:5433/mais_horas_teste
PGSSL=false

# ===== Segredos =====
# Gere os dois com: python -m app.cli gerar-segredos
# São independentes de propósito: comprometer o QR de presença não pode
# comprometer a sessão dos usuários.
JWT_SECRET=
CHECKIN_SECRET=

# ===== Assinatura do certificado =====
# Gere com: python -m app.cli gerar-chave
# NUNCA versione esta linha. A chave privada não vai para o banco nem para o git.
CHAVE_ASSINATURA=

# ===== Sessão =====
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7

# ===== URLs públicas =====
APP_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Origens permitidas, separadas por vírgula.
# Vazio libera todas — em produção a API se recusa a subir sem valor.
CORS_ORIGIN=

# ===== E-mail =====
# "console" escreve o link no terminal, sem depender de provedor externo.
EMAIL_MODO=console

# ===== Portal =====
# Código de um certificado de conta de teste para "Ver uma verificação de
# exemplo" (T2). Vazio esconde o botão.
CERTIFICADO_DEMONSTRACAO=
