# Um endereço só para site e API: o cookie de sessão fica "do próprio site" e
# não cai no Safari. O Caddy emite e renova o certificado HTTPS sozinho.
{$DOMINIO} {
	encode zstd gzip

	# A CITINOVA usa apenas esta rota; o restante do Mais Horas nao muda.
	handle_path /citinova/* {
		# Telemetria do totem: o corte de tamanho acontece aqui, antes da API.
		request_body {
			max_size 64KB
		}
		reverse_proxy citinova-api:8000
	}

	# Monitoramento (deploy/monitoramento): o Grafana tem login próprio, e o
	# relatório em PDF só sai para quem tem sessão aberta nele. Se o
	# monitoramento estiver desligado, só estes caminhos respondem 502.
	handle /monitoramento/relatorios/* {
		forward_auth monitoramento-grafana:3000 {
			uri /monitoramento/api/user
		}
		reverse_proxy monitoramento-relatorios:8000
	}

	handle /monitoramento* {
		reverse_proxy monitoramento-grafana:3000
	}

	@api path /api/* /uploads/* /saude
	handle @api {
		# Sem trusted_proxies, o Caddy descarta o X-Forwarded-For que vier do
		# cliente e grava o IP real — é nele que a auditoria e o rate limit confiam.
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Arquivos do build têm hash no nome: podem ficar em cache para sempre.
	@estaticos path /assets/*
	header @estaticos Cache-Control "public, max-age=31536000, immutable"
}
