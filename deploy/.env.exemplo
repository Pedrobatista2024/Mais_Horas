# Modelo do deploy/.env. O instalar.sh gera o arquivo real com segredos novos.
# NUNCA versione o .env.

# Endereço público (sem https://). Ex.: maishoras.northcentralus.cloudapp.azure.com
DOMINIO=

# Gerados pelo instalar.sh
POSTGRES_SENHA=
JWT_SECRET=
CHECKIN_SECRET=

# Chave Ed25519 dos certificados. NUNCA troque depois de emitir:
# todo certificado já emitido deixaria de validar. Guarde cópia fora do servidor.
CHAVE_ASSINATURA=

ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7
EMAIL_MODO=console
