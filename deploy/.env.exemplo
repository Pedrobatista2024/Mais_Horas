# Modelo do deploy/.env. O instalar.sh gera o arquivo real com segredos novos.
# NUNCA versione o .env.

# Endereço público (sem https://). Ex.: maishoras.northcentralus.cloudapp.azure.com
DOMINIO=

# Gerados pelo instalar.sh
POSTGRES_SENHA=
JWT_SECRET=
CHECKIN_SECRET=

# Chave Ed25519 dos certificados. NUNCA troque depois de emitir:
# todo certificado já emitido deixaria de validar. Guarde cópia fora do servidor.
CHAVE_ASSINATURA=

# Entrada pelo Google (opcional). Vazio: o botão não aparece.
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DOMINIO_INSTITUCIONAL=unicearense.edu.br

ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7
EMAIL_MODO=console

# Opcional: código de um certificado de uma conta de TESTE, para o botão
# "Ver uma verificação de exemplo" da página Como funciona.
CERTIFICADO_DEMONSTRACAO=
