    {
      "type": "stat",
      "title": "Leituras do cache",
      "description": "Quanto das leituras não precisou ir ao disco. Abaixo de 90% é sinal de memória curta ou consulta varrendo tabela.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"mais_horas\"}[15m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"mais_horas\"}[15m])) + sum(rate(pg_stat_database_blks_read{datname=\"mais_horas\"}[15m])), 1e-9) * 100",
          "legendFormat": "",
          "instant": false,
          "range": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#f2a20c",
                "value": 90
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
