    {
      "type": "table",
      "title": "Consultas que mais consomem tempo",
      "description": "Acumulado desde o último reinício do banco (pg_stat_statements). Média alta = consulta lenta; tempo total alto = consulta frequente.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mais-horas-banco"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mais-horas-banco"
          },
          "refId": "A",
          "rawSql": "SELECT left(regexp_replace(s.query, '\\s+', ' ', 'g'), 160) AS \"Consulta\",\n                   s.calls AS \"Chamadas\",\n                   round(s.total_exec_time::numeric, 1) AS \"Tempo total (ms)\",\n                   round(s.mean_exec_time::numeric, 2) AS \"Média (ms)\",\n                   round(s.max_exec_time::numeric, 1) AS \"Pior (ms)\",\n                   s.rows AS \"Linhas\"\n            FROM pg_stat_statements s\n            JOIN pg_database d ON d.oid = s.dbid\n            WHERE d.datname = 'mais_horas'\n              AND pg_get_userbyid(s.userid) NOT IN ('monitoramento', 'painel')\n              AND s.query !~* '^\\s*(create|alter|grant|revoke|comment|set|show|vacuum)'\n            ORDER BY s.total_exec_time DESC LIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Nada no período",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Média (ms)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "#f2a20c",
                      "value": 50
                    },
                    {
