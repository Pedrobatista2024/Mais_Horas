          "expr": "(sum by (metodo, rota) (increase(maishoras_http_requisicoes_total{status=~\"4..\", rota!=\"nao_encontrada\"}[$__range])) or (sum by (metodo, rota) (increase(maishoras_http_requisicoes_total{rota!=\"nao_encontrada\"}[$__range])) > 0) * 0) / (sum by (metodo, rota) (increase(maishoras_http_requisicoes_total{rota!=\"nao_encontrada\"}[$__range])) > 0)",
