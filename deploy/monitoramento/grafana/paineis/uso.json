    {
      "type": "table",
      "title": "Atividades com mais procura",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mais-horas-banco"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mais-horas-banco"
          },
          "refId": "A",
          "rawSql": "SELECT a.titulo AS \"Atividade\", o.nome AS \"ONG\", a.data AS \"Data\",\n                   count(i.id) FILTER (WHERE i.situacao IN ('pendente', 'confirmada',\n                                                            'presente', 'ausente'))\n                       AS \"Inscritos\",\n                   a.vagas_max AS \"Vagas\"\n            FROM atividades a\n            JOIN usuarios o ON o.id = a.ong_id\n            LEFT JOIN inscricoes i ON i.atividade_id = a.id\n            WHERE a.situacao <> 'rascunho' AND a.data >= current_date - 30\n            GROUP BY a.id, o.nome ORDER BY 4 DESC, a.data LIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Nada no período",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Data"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Inscritos"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Vagas"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "transformations": [],
      "id": 11
