    {
      "type": "timeseries",
      "title": "Contas novas por dia",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mais-horas-banco"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mais-horas-banco"
          },
          "refId": "A",
          "rawSql": "SELECT $__timeGroupAlias(criado_em, '1d'),\n                   CASE papel WHEN 'estudante' THEN 'estudantes' WHEN 'ong' THEN 'ONGs'\n                        ELSE papel END AS metric, count(*) AS valor\n            FROM usuarios WHERE $__timeFilter(criado_em)\n            GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Nada no período",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "estudantes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
