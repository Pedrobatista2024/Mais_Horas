    {
      "type": "table",
      "title": "Alertas ativos",
      "description": "Regras de prometheus/alertas.yml disparadas agora. Crítico: olhar agora. Atenção: olhar hoje.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Nenhum alerta disparado agora",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Nível"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critico": {
                        "text": "Crítico",
                        "color": "red",
                        "index": 0
                      },
                      "atencao": {
                        "text": "Atenção",
                        "color": "#f2a20c",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
