    {
      "type": "table",
      "title": "IPs com mais logins recusados",
      "description": "Da trilha de auditoria. Muitas recusas de um IP só = força bruta; muitas contas visadas = lista de e-mails sendo testada.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mais-horas-banco"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mais-horas-banco"
          },
          "refId": "A",
          "rawSql": "SELECT host(ip) AS \"IP\", count(*) AS \"Recusas\",\n                   count(DISTINCT entidade_id) AS \"Contas visadas\",\n                   max(ocorrido_em) AS \"Última\", max(user_agent) AS \"Navegador\"\n            FROM registros_auditoria\n            WHERE acao = 'sessao.falha' AND $__timeFilter(ocorrido_em)\n            GROUP BY ip ORDER BY 2 DESC LIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Nenhum login recusado no período",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Recusas"
            },
