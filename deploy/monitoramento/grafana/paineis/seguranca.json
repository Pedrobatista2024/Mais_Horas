    {
      "type": "stat",
      "title": "Taxa de recusa",
      "description": "Recusados sobre o total de tentativas. Erro de digitação fica abaixo de 20%; acima disso, alguém está chutando senha.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(increase(maishoras_eventos_total{acao=\"sessao.falha\"}[$__range]))) / clamp_min(sum(increase(maishoras_eventos_total{acao=\"sessao.falha\"}[$__range])) + sum(increase(maishoras_eventos_total{acao=\"sessao.iniciada\"}[$__range])), 1) * 100 or vector(0)",
