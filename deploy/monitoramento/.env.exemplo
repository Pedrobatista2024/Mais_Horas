# Modelo do deploy/monitoramento/.env. O preparar.sh gera o arquivo real com
# senhas novas. NUNCA versione o .env.

# O mesmo endereço do deploy/.env da aplicação (sem https://).
DOMINIO=

# Entrada no Grafana em https://DOMINIO/monitoramento/
GRAFANA_USUARIO=admin
GRAFANA_SENHA=

# Papéis do Postgres criados pelo preparar.sh.
POSTGRES_MONITOR_SENHA=
POSTGRES_PAINEL_SENHA=

# Senha das contas de demonstração do simulador (@demonstracao.mais-horas.org).
SENHA_DEMONSTRACAO=
# 1 = movimento normal; 2 = o dobro. Vale só com --profile demonstracao.
INTENSIDADE_DEMONSTRACAO=1
